# Copy to .env and fill in. All values are optional for local dev.

# Telegram bot token from @BotFather — enables initData auth + Stars payments.
BOT_TOKEN=

# Real AI analysis in /api/analyze. Set ONE provider; without a key the
# deterministic engine is used. If both are set, xAI (Grok) wins.
#
# Grok (xAI) — OpenAI-compatible:
XAI_API_KEY=
XAI_MODEL=grok-4
#
# or Claude (Anthropic):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Server
PORT=8080

# Path to the mini-app HTML that gets served (defaults to ../bradar.html)
# MINIAPP_HTML=/absolute/path/to/bradar.html

# LOCAL DEV ONLY: accept requests without a valid Telegram signature.
# Leave empty in production (auth is then enforced whenever BOT_TOKEN is set).
ALLOW_INSECURE_AUTH=1
