# Copy to .env and fill in.
# REQUIRED at launch: BOT_TOKEN, APP_URL, TELEGRAM_WEBHOOK_SECRET, and a durable
# store (UPSTASH_* / KV_*). Everything else is optional (feature-gated).

# --- REQUIRED for a real launch -------------------------------------------

# Telegram bot token from @BotFather — enables initData auth + Stars payments.
BOT_TOKEN=

# Public https URL of the mini-app (used by /start button, menu, webhook reply).
APP_URL=

# Durable storage (Upstash Redis REST — free tier works on Vercel). Without these
# on serverless, plans/favourites/PRO are stored in ephemeral /tmp and LOST between
# requests. Create a DB at console.upstash.com and paste the REST URL + token.
# (Vercel KV also works: it injects KV_REST_API_URL / KV_REST_API_TOKEN instead.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret shared with Telegram so the payment webhook can't be forged. Pick any
# random string, put it here, then run:  node bot.js setwebhook https://you/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# --- OPTIONAL: AI enrichment ----------------------------------------------
# Set ONE provider; without a key the deterministic engine is used. If both are
# set, xAI (Grok) wins. Verify the model id against the provider's current API.
XAI_API_KEY=
XAI_MODEL=grok-4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OPTIONAL: real channel data (Telemetr.io) ----------------------------
TELEMETR_API_KEY=
# TELEMETR_BASE=https://api.tlmtr.io

# TGStat Stat API token — resolves real @usernames / t.me links + contacts for the
# channels in the plan (Telemetr's free tier has no usernames). Get it in the TGStat
# cabinet: Мои услуги → Доступ к Stat API → подключить.
TGSTAT_TOKEN=
# TGSTAT_TIMEOUT_MS=6000

# --- OPTIONAL: ops ---------------------------------------------------------
PORT=8080
# Token that unlocks the /api/source-check diagnostic (disabled if unset).
ADMIN_TOKEN=
# Outbound timeouts (ms) — keep below the platform function limit.
# AI_TIMEOUT_MS=12000
# TELEMETR_TIMEOUT_MS=6000
# Path to the mini-app HTML that gets served (defaults to ../bradar.html)
# MINIAPP_HTML=/absolute/path/to/bradar.html

# LOCAL DEV ONLY: accept requests without a valid Telegram signature.
# MUST be empty/absent in production — with BOT_TOKEN set, auth is then enforced.
ALLOW_INSECURE_AUTH=
